{
  "name": "SMS Modem Gateway (Lean Experiment)",
  "version": "0.1.0-dev.2",
  "slug": "sms_modem_gateway_lean",
  "description": "Minimal REST SMS and voice gateway with durable multipart assembly",
  "startup": "services",
  "arch": ["amd64", "i386", "aarch64", "armv7", "armhf"],
  "boot": "auto",
  "panel_icon": "mdi:cellphone-message",
  "url": "https://github.com/BrainDeLook/home-assistant-addons-ru/tree/experiment/lean-rest-engine/sms-gammu-gateway",
  "homeassistant": "2024.1.0",
  "options": {
    "device_path": "/dev/ttyUSB0",
    "modem_baud_rate": "115200",
    "pin": "",
    "username": "admin",
    "password": "password",
    "poll_interval": 10,
    "voice_call_enabled": false,
    "message_retention_days": 30
  },
  "schema": {
    "device_path": "str",
    "modem_baud_rate": "match(^(auto|[0-9]+)$)",
    "pin": "password?",
    "username": "str",
    "password": "password",
    "poll_interval": "int(5,300)",
    "voice_call_enabled": "bool",
    "message_retention_days": "int(1,365)"
  },
  "ingress": true,
  "ingress_port": 5000,
  "host_network": false,
  "devices": [
    "/dev/ttyUSB0:/dev/ttyUSB0:rwm",
    "/dev/ttyUSB1:/dev/ttyUSB1:rwm",
    "/dev/ttyUSB2:/dev/ttyUSB2:rwm",
    "/dev/ttyUSB3:/dev/ttyUSB3:rwm",
    "/dev/ttyUSB4:/dev/ttyUSB4:rwm",
    "/dev/ttyUSB5:/dev/ttyUSB5:rwm",
    "/dev/ttyACM0:/dev/ttyACM0:rwm",
    "/dev/ttyACM1:/dev/ttyACM1:rwm",
    "/dev/ttyAMA0:/dev/ttyAMA0:rwm",
    "/dev/ttyS0:/dev/ttyS0:rwm"
  ],
  "privileged": ["SYS_RAWIO"],
  "udev": true,
  "init": false,
  "ports": {"5000/tcp": 5000},
  "ports_description": {"5000/tcp": "Lean SMS Gateway REST API"}
}
