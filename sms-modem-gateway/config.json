{
  "name": "SMS Modem Gateway (Lean Experiment)",
  "version": "0.1.0-dev.8",
  "slug": "sms_modem_gateway_lean",
  "description": "Minimal REST SMS gateway with durable multipart assembly",
  "startup": "services",
  "arch": ["amd64", "aarch64"],
  "panel_icon": "mdi:cellphone-message",
  "url": "https://github.com/BrainDeLook/sms-modem-gateway-ha/tree/main/sms-modem-gateway",
  "homeassistant": "2024.1.0",
  "options": {
    "device_path": "/dev/ttyUSB0",
    "modem_baud_rate": "115200",
    "pin": "",
    "username": "admin",
    "password": "password",
    "poll_interval": 10,
    "message_retention_days": 30
  },
  "schema": {
    "device_path": "str",
    "modem_baud_rate": "match(^(auto|[0-9]+)$)",
    "pin": "password?",
    "username": "str",
    "password": "password",
    "poll_interval": "int(5,300)",
    "message_retention_days": "int(1,365)"
  },
  "ingress": true,
  "ingress_port": 5000,
  "devices": [
    "/dev/ttyUSB0",
    "/dev/ttyUSB1",
    "/dev/ttyUSB2",
    "/dev/ttyUSB3",
    "/dev/ttyUSB4",
    "/dev/ttyUSB5",
    "/dev/ttyACM0",
    "/dev/ttyACM1",
    "/dev/ttyAMA0",
    "/dev/ttyS0"
  ],
  "privileged": ["SYS_RAWIO"],
  "udev": true,
  "init": false,
  "ports": {"5000/tcp": 5000},
  "ports_description": {"5000/tcp": "Lean SMS Gateway REST API"}
}
